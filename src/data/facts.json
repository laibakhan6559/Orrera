[
  {
    "id": "f-sun-mass",
    "text": "The Sun holds about 99.86% of all the mass in the Solar System.",
    "category": "sun",
    "relatedObjectIds": ["sun"],
    "source": { "title": "NASA Sun Fact Sheet", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/sunfact.html" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-sun-light",
    "text": "Sunlight takes about 8 minutes and 20 seconds to travel from the Sun to Earth.",
    "category": "sun",
    "relatedObjectIds": ["sun", "earth"],
    "source": { "title": "NASA Science: Sun", "url": "https://science.nasa.gov/sun/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-sun-core",
    "text": "The Sun's core is about 15 million °C, hot enough to fuse hydrogen into helium.",
    "category": "sun",
    "relatedObjectIds": ["sun"],
    "source": { "title": "NASA Science: Sun", "url": "https://science.nasa.gov/sun/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-sun-age",
    "text": "The Sun formed about 4.6 billion years ago.",
    "category": "sun",
    "relatedObjectIds": ["sun"],
    "source": { "title": "NASA Science: Sun", "url": "https://science.nasa.gov/sun/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-mercury-day",
    "text": "One day on Mercury, from sunrise to sunrise, lasts about 176 Earth days, twice as long as its 88-day year.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["mercury"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-mercury-temp",
    "text": "Mercury has almost no atmosphere to hold heat, so its surface swings from about -180 °C at night to about 430 °C by day.",
    "category": "extreme-environments",
    "relatedObjectIds": ["mercury"],
    "source": { "title": "NASA Science: Mercury", "url": "https://science.nasa.gov/mercury/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-venus-hot",
    "text": "Venus is the hottest planet, with an average surface temperature of about 464 °C. It is hotter than Mercury even though it is almost twice as far from the Sun.",
    "category": "extreme-environments",
    "relatedObjectIds": ["venus", "mercury"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-venus-day",
    "text": "A day on Venus is longer than its year: it takes about 243 Earth days to rotate once but only about 225 Earth days to orbit the Sun.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["venus"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-venus-retro",
    "text": "Venus spins backwards compared with most planets, so on Venus the Sun rises in the west and sets in the east.",
    "category": "planets",
    "relatedObjectIds": ["venus"],
    "source": { "title": "NASA Science: Venus", "url": "https://science.nasa.gov/venus/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-earth-water",
    "text": "About 71% of Earth's surface is covered by water.",
    "category": "planets",
    "relatedObjectIds": ["earth"],
    "source": { "title": "NASA Science: Earth", "url": "https://science.nasa.gov/earth/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-earth-tilt",
    "text": "Earth's axial tilt of about 23.4° is what gives us the seasons.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["earth"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-earth-life",
    "text": "Earth is the only planet known to host life.",
    "category": "planets",
    "relatedObjectIds": ["earth"],
    "source": { "title": "NASA Science: Earth", "url": "https://science.nasa.gov/earth/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-moon-drift",
    "text": "The Moon is slowly drifting away from Earth at about 3.8 centimetres every year.",
    "category": "moons",
    "relatedObjectIds": ["earth"],
    "source": { "title": "NASA Science: Earth's Moon", "url": "https://science.nasa.gov/moon/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-mars-volcano",
    "text": "Olympus Mons on Mars is the tallest known volcano in the Solar System, about 22 km high, roughly two and a half times the height of Mount Everest.",
    "category": "planets",
    "relatedObjectIds": ["mars"],
    "source": { "title": "NASA Science: Mars", "url": "https://science.nasa.gov/mars/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-mars-red",
    "text": "Mars looks red because its dust and rocks are rich in iron oxide, the same compound as rust.",
    "category": "planets",
    "relatedObjectIds": ["mars"],
    "source": { "title": "NASA Science: Mars", "url": "https://science.nasa.gov/mars/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-mars-pressure",
    "text": "The air on Mars is so thin that surface pressure is less than 1% of Earth's.",
    "category": "extreme-environments",
    "relatedObjectIds": ["mars"],
    "source": { "title": "NASA Science: Mars", "url": "https://science.nasa.gov/mars/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-jupiter-mass",
    "text": "Jupiter is more than twice as massive as all the other planets in the Solar System combined.",
    "category": "planets",
    "relatedObjectIds": ["jupiter"],
    "source": { "title": "NASA Science: Jupiter", "url": "https://science.nasa.gov/jupiter/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-jupiter-day",
    "text": "Jupiter has the shortest day of any planet, rotating once in under 10 hours.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["jupiter"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-jupiter-spot",
    "text": "Jupiter's Great Red Spot is a storm wider than Earth that has been observed for well over a century.",
    "category": "extreme-environments",
    "relatedObjectIds": ["jupiter"],
    "source": { "title": "NASA Science: Jupiter", "url": "https://science.nasa.gov/jupiter/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-saturn-density",
    "text": "Saturn's average density is lower than that of water, so it would float in a bathtub big enough to hold it.",
    "category": "planets",
    "relatedObjectIds": ["saturn"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-saturn-rings",
    "text": "Saturn's rings are made mostly of water ice and stretch hundreds of thousands of kilometres across, yet they are extremely thin.",
    "category": "planets",
    "relatedObjectIds": ["saturn"],
    "source": { "title": "NASA Science: Saturn", "url": "https://science.nasa.gov/saturn/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-uranus-tilt",
    "text": "Uranus is tipped on its side, with an axial tilt of about 98°.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["uranus"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-uranus-cold",
    "text": "Uranus has the coldest planetary atmosphere measured, dropping to about -224 °C.",
    "category": "extreme-environments",
    "relatedObjectIds": ["uranus"],
    "source": { "title": "NASA Science: Uranus", "url": "https://science.nasa.gov/uranus/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-neptune-wind",
    "text": "Neptune's winds can exceed 1,200 mph (about 1,900 km/h), the fastest measured on any planet.",
    "category": "extreme-environments",
    "relatedObjectIds": ["neptune"],
    "source": { "title": "NASA Science: Neptune", "url": "https://science.nasa.gov/neptune/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-neptune-year",
    "text": "A year on Neptune lasts about 165 Earth years. It completed its first orbit since its 1846 discovery in 2011.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["neptune"],
    "source": { "title": "NASA Science: Neptune", "url": "https://science.nasa.gov/neptune/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-neptune-light",
    "text": "Sunlight takes more than four hours to reach Neptune.",
    "category": "orbital-mechanics",
    "relatedObjectIds": ["neptune", "sun"],
    "source": { "title": "NASA Planetary Fact Sheet (Metric)", "url": "https://nssdc.gsfc.nasa.gov/planetary/factsheet/" },
    "lastReviewed": "2026-11-12"
  },
  {
    "id": "f-giants",
    "text": "Jupiter and Saturn are gas giants. Uranus and Neptune are called ice giants because they contain large amounts of water, methane and ammonia.",
    "category": "planets",
    "relatedObjectIds": ["jupiter", "saturn", "uranus", "neptune"],
    "source": { "title": "NASA Science: Our Solar System", "url": "https://science.nasa.gov/solar-system/" },
    "lastReviewed": "2026-11-12"
  }
]
